# ==============================================================
# POP Microarray - GSE1009 (Nefropatia diabética vs Controle)
# Execute com o RStudio Project aberto na pasta Projeto_Microarray
# ==============================================================

# 01. Pacotes ---------------------------------------------------
# (instalação: rodar UMA vez, ver seção 5 do POP)
install.packages(c("BiocManager", "ggplot2", "pheatmap"))
BiocManager::install(c("GEOquery", "affy", "limma", "hgu95av2.db", "hgu95av2cdf",
                        "AnnotationDbi", "clusterProfiler", "org.Hs.eg.db", "enrichplot"))

library(GEOquery)
library(affy)
library(limma)
library(hgu95av2.db)
library(AnnotationDbi)
library(clusterProfiler)
library(org.Hs.eg.db)
library(enrichplot)
library(ggplot2)
library(pheatmap)

set.seed(123)
options(timeout = 600)

# Parâmetros da análise (não alterar sem registrar no POP)
fdr_corte <- 0.05   # FDR máximo
lfc_corte <- 1      # |log2FC| mínimo
n_heatmap <- 50     # nº máximo de genes no heatmap

# Pastas de saída
for (p in c("01_Dados", "02_Scripts", "03_Resultados", "04_Figuras",
            "05_Tabelas", "06_Documentacao")) dir.create(p, showWarnings = FALSE)

# 02. Importação dos dados ---------------------------------------
if (!file.exists("01_Dados/GSE1009/GSE1009_RAW.tar")) {
  getGEOSuppFiles("GSE1009", baseDir = "01_Dados")
}
untar("01_Dados/GSE1009/GSE1009_RAW.tar", exdir = "01_Dados/GSE1009/CEL")

arquivos_cel <- list.files("01_Dados/GSE1009/CEL", pattern = "\\.CEL(\\.gz)?$",
                           ignore.case = TRUE, full.names = TRUE, recursive = TRUE)
if (length(arquivos_cel) != 6) stop("Esperados 6 arquivos .CEL; encontrados: ", length(arquivos_cel))

afy <- ReadAffy(filenames = arquivos_cel)
sampleNames(afy) <- sub("[._].*$", "", sampleNames(afy))   # fica só o código GSM

# 03. Organização dos grupos -------------------------------------
gse  <- getGEO("GSE1009", GSEMatrix = TRUE, getGPL = FALSE)
meta <- pData(phenoData(gse[[1]]))
print(meta[, c("geo_accession", "title", "source_name_ch1")])

# PREENCHER com os GSM lidos na tabela acima (CONFIRMAR ESTA INFORMAÇÃO NO GEO)
gsm_controle <- c("GSM15965", "GSM15966", "GSM15967")
gsm_DN       <- c("GSM15968", "GSM15969", "GSM15970")

if (!setequal(c(gsm_controle, gsm_DN), sampleNames(afy)))
  stop("Os GSM informados não batem com as amostras importadas. Revise gsm_controle e gsm_DN.")

info <- data.frame(amostra = sampleNames(afy), stringsAsFactors = FALSE)
info$grupo <- factor(ifelse(info$amostra %in% gsm_DN, "DN", "Controle"),
                     levels = c("Controle", "DN"))
print(info)
print(table(info$grupo))

cores <- c(Controle = "#2C7BB6", DN = "#D7191C")
cor_amostra <- cores[as.character(info$grupo)]

# 04. Pré-processamento (RMA) -------------------------------------
png("04_Figuras/01_boxplot_antes_RMA.png", width = 1600, height = 1200, res = 200)
boxplot(afy, col = cor_amostra, las = 2,
        main = "Antes da normalização (log2)", ylab = "log2(intensidade)")
dev.off()

eset <- rma(afy)                 # background + normalização por quantis + resumo (RMA)
expr_sondas <- exprs(eset)       # matriz sondas x amostras (log2)

png("04_Figuras/02_boxplot_depois_RMA.png", width = 1600, height = 1200, res = 200)
boxplot(expr_sondas, col = cor_amostra, las = 2,
        main = "Depois da normalização (RMA, log2)", ylab = "log2(expressão)")
dev.off()

# Sonda -> gene (Entrez); sondas sem gene são removidas; sondas do mesmo gene são promediadas
id_entrez <- mapIds(hgu95av2.db, keys = rownames(expr_sondas), column = "ENTREZID",
                    keytype = "PROBEID", multiVals = "first")
manter    <- !is.na(id_entrez)
expr_gene <- avereps(expr_sondas[manter, ], ID = id_entrez[manter])
simbolos  <- mapIds(hgu95av2.db, keys = rownames(expr_gene), column = "SYMBOL",
                    keytype = "ENTREZID", multiVals = "first")

# PCA
pca <- prcomp(t(expr_gene), scale. = FALSE)
pct <- round(100 * pca$sdev^2 / sum(pca$sdev^2), 1)
df_pca <- data.frame(PC1 = pca$x[, 1], PC2 = pca$x[, 2],
                     amostra = info$amostra, grupo = info$grupo)
p_pca <- ggplot(df_pca, aes(PC1, PC2, color = grupo, label = amostra)) +
  geom_point(size = 4) +
  geom_text(vjust = -1, show.legend = FALSE) +
  scale_color_manual(values = cores) +
  labs(x = paste0("PC1 (", pct[1], "%)"), y = paste0("PC2 (", pct[2], "%)"),
       color = "Grupo", title = "PCA - GSE1009") +
  theme_bw()
ggsave("04_Figuras/03_PCA.png", p_pca, width = 6, height = 5, dpi = 300)

# 05. Análise diferencial (limma) ---------------------------------
design <- model.matrix(~ grupo, data = info)     # log2FC = DN - Controle
fit    <- eBayes(lmFit(expr_gene, design))
tabela <- topTable(fit, coef = "grupoDN", number = Inf,
                   adjust.method = "BH", sort.by = "P")

# 06. Resultados ---------------------------------------------------
tabela$ENTREZID <- rownames(tabela)
tabela$SYMBOL   <- unname(simbolos[tabela$ENTREZID])
tabela$regulacao <- "Nao_significativo"
tabela$regulacao[tabela$adj.P.Val < fdr_corte & tabela$logFC >=  lfc_corte] <- "Aumentado"
tabela$regulacao[tabela$adj.P.Val < fdr_corte & tabela$logFC <= -lfc_corte] <- "Reduzido"
tabela <- tabela[, c("ENTREZID", "SYMBOL", "logFC", "AveExpr", "t",
                     "P.Value", "adj.P.Val", "B", "regulacao")]
deg <- tabela[tabela$regulacao != "Nao_significativo", ]

print(table(tabela$regulacao))
write.csv(tabela, "05_Tabelas/tabela_completa_limma.csv", row.names = FALSE)
write.csv(deg,    "05_Tabelas/genes_diferencialmente_expressos.csv", row.names = FALSE)

# 07. Gráficos ------------------------------------------------------
# Volcano plot
p_vulcao <- ggplot(tabela, aes(x = logFC, y = -log10(adj.P.Val), color = regulacao)) +
  geom_point(alpha = 0.6, size = 1.5) +
  scale_color_manual(values = c(Aumentado = "#D7191C", Reduzido = "#2C7BB6",
                                Nao_significativo = "grey70")) +
  geom_vline(xintercept = c(-lfc_corte, lfc_corte), linetype = "dashed") +
  geom_hline(yintercept = -log10(fdr_corte), linetype = "dashed") +
  labs(x = "log2 Fold Change (DN vs Controle)", y = "-log10(FDR)",
       color = "Regulação", title = "Volcano plot - GSE1009") +
  theme_bw()
ggsave("04_Figuras/04_volcano.png", p_vulcao, width = 7, height = 6, dpi = 300)

# Heatmap (até n_heatmap DEGs com menor FDR; z-score por gene)
if (nrow(deg) < 2) stop("Menos de 2 DEGs: heatmap não pode ser feito. Ver seção 19 do POP.")
deg_top <- head(deg, n_heatmap)                       # deg já está ordenado por p-valor
mat <- expr_gene[deg_top$ENTREZID, , drop = FALSE]
rownames(mat) <- make.unique(ifelse(is.na(deg_top$SYMBOL), deg_top$ENTREZID, deg_top$SYMBOL))
anot_col <- data.frame(Grupo = info$grupo, row.names = info$amostra)
pheatmap(mat, scale = "row",
         annotation_col = anot_col, annotation_colors = list(Grupo = cores),
         clustering_distance_rows = "euclidean", clustering_method = "complete",
         main = "Heatmap dos DEGs - GSE1009",
         filename = "04_Figuras/05_heatmap_DEGs.png", width = 7, height = 9)

# 08. Análise funcional (GO/KEGG) --------------------------------------
if (nrow(deg) < 10) stop("Menos de 10 DEGs: análise funcional não recomendada. Ver seção 19 do POP.")
genes_deg <- deg$ENTREZID          # genes de interesse (sem duplicatas)
universo  <- tabela$ENTREZID       # universo = todos os genes testados

go <- enrichGO(gene = genes_deg, universe = universo, OrgDb = org.Hs.eg.db,
               keyType = "ENTREZID", ont = "BP", pAdjustMethod = "BH",
               pvalueCutoff = 0.05, qvalueCutoff = 0.05,
               minGSSize = 10, maxGSSize = 500, readable = TRUE)

kegg <- enrichKEGG(gene = genes_deg, universe = universo, organism = "hsa",
                   pAdjustMethod = "BH", pvalueCutoff = 0.05, qvalueCutoff = 0.05,
                   minGSSize = 10, maxGSSize = 500)
if (!is.null(kegg) && nrow(as.data.frame(kegg)) > 0)
  kegg <- setReadable(kegg, OrgDb = org.Hs.eg.db, keyType = "ENTREZID")

tem_go   <- !is.null(go)   && nrow(as.data.frame(go))   > 0
tem_kegg <- !is.null(kegg) && nrow(as.data.frame(kegg)) > 0

if (tem_go) {
  p_go <- dotplot(go, showCategory = 15) + ggtitle("GO - Processos Biológicos")
  ggsave("04_Figuras/06_GO_BP_dotplot.png", p_go, width = 8, height = 7, dpi = 300)
}
if (tem_kegg) {
  p_kegg <- dotplot(kegg, showCategory = 15) + ggtitle("KEGG")
  ggsave("04_Figuras/07_KEGG_dotplot.png", p_kegg, width = 8, height = 7, dpi = 300)
}

# 09. Exportação ------------------------------------------------------
expr_export <- cbind(ENTREZID = rownames(expr_gene),
                     SYMBOL = unname(simbolos[rownames(expr_gene)]),
                     as.data.frame(expr_gene))
write.csv(expr_export, "03_Resultados/matriz_expressao_normalizada_genes.csv", row.names = FALSE)
if (tem_go)   write.csv(as.data.frame(go),   "05_Tabelas/GO_BP_enriquecimento.csv",  row.names = FALSE)
if (tem_kegg) write.csv(as.data.frame(kegg), "05_Tabelas/KEGG_enriquecimento.csv",   row.names = FALSE)

resumo <- data.frame(
  parametro = c("genes_analisados", "DEGs_total", "DEGs_aumentados", "DEGs_reduzidos"),
  valor = c(nrow(tabela), nrow(deg),
            sum(tabela$regulacao == "Aumentado"), sum(tabela$regulacao == "Reduzido")))
write.csv(resumo, "05_Tabelas/resumo_numeros.csv", row.names = FALSE)

writeLines(c(paste("Data da análise:", Sys.Date()),
             paste("Bioconductor:", as.character(BiocManager::version())),
             capture.output(sessionInfo())),
           "06_Documentacao/sessionInfo.txt")



# ==============================================================================
# FIM DO SCRIPT
