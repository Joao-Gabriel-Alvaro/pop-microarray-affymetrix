# =============================================================================
# GSE1009 — PIPELINE COMPLETO
# Análise de expressão diferencial em microarray Affymetrix HG_U95Av2
# =============================================================================

# -----------------------------------------------------------------------------
# 0. PACOTES
# -----------------------------------------------------------------------------

library(GEOquery)
library(oligo)
library(pd.hg.u95av2)
library(limma)
library(genefilter)
library(ggplot2)
library(AnnotationDbi)
library(hgu95av2.db)
library(clusterProfiler)
library(org.Hs.eg.db)

# -----------------------------------------------------------------------------
# 1. PASTAS
# -----------------------------------------------------------------------------

dir.create("resultados_GSE1009",
           showWarnings = FALSE)

dir.create("resultados_GSE1009/figuras",
           showWarnings = FALSE)

dir.create("GSE1009/CEL_files",
           recursive = TRUE,
           showWarnings = FALSE)

# -----------------------------------------------------------------------------
# 2. DOWNLOAD DO GEO
# -----------------------------------------------------------------------------

getGEOSuppFiles(
  "GSE1009",
  makeDirectory = TRUE,
  baseDir = getwd()
)

# -----------------------------------------------------------------------------
# 3. EXTRAÇÃO DOS CEL
# -----------------------------------------------------------------------------

untar(
  "GSE1009/GSE1009_RAW.tar",
  exdir = "GSE1009/CEL_files"
)

# -----------------------------------------------------------------------------
# 4. LOCALIZAR CEL
# -----------------------------------------------------------------------------

cel_files <- list.files(
  "GSE1009/CEL_files",
  pattern = "\\.CEL(\\.gz)?$",
  full.names = TRUE,
  ignore.case = TRUE
)

if (length(cel_files) != 6) {
  stop(
    paste(
      "Esperados 6 arquivos CEL, encontrados:",
      length(cel_files)
    )
  )
}

# -----------------------------------------------------------------------------
# 5. EXTRAIR GSM DOS NOMES DOS CEL
# -----------------------------------------------------------------------------

extract_gsm <- function(x) {

  nome <- basename(x)

  pos <- regexpr(
    "GSM[0-9]+",
    nome,
    perl = TRUE
  )

  if (pos[1] == -1) {
    return(NA_character_)
  }

  regmatches(nome, pos)
}

gsm_cel <- vapply(
  cel_files,
  extract_gsm,
  character(1)
)

if (anyNA(gsm_cel)) {
  stop("Não foi possível identificar o GSM em pelo menos um arquivo CEL.")
}

# -----------------------------------------------------------------------------
# 6. METADADOS GEO
# -----------------------------------------------------------------------------

gse <- getGEO(
  "GSE1009",
  GSEMatrix = TRUE
)

obj_gse <- gse[[1]]

if (inherits(obj_gse, "ExpressionSet")) {

  pheno <- Biobase::pData(obj_gse)

} else if (inherits(obj_gse, "SummarizedExperiment")) {

  pheno <- as.data.frame(
    SummarizedExperiment::colData(obj_gse)
  )

} else {

  stop("Tipo de objeto GEO não reconhecido.")
}

if (!"geo_accession" %in% colnames(pheno)) {
  stop("A coluna geo_accession não foi encontrada.")
}

if (!"title" %in% colnames(pheno)) {
  stop("A coluna title não foi encontrada.")
}

# -----------------------------------------------------------------------------
# 7. REORDENAR METADADOS PELO GSM DOS CEL
# -----------------------------------------------------------------------------

idx <- match(
  gsm_cel,
  pheno$geo_accession
)

if (anyNA(idx)) {
  stop(
    "Existe pelo menos um CEL sem correspondência nos metadados."
  )
}

pheno <- pheno[
  idx,
  ,
  drop = FALSE
]

rownames(pheno) <- gsm_cel

# -----------------------------------------------------------------------------
# 8. DEFINIR GRUPOS
# -----------------------------------------------------------------------------

pheno$Grupo <- NA_character_

pheno$Grupo[
  grepl(
    "^Control",
    pheno$title,
    ignore.case = TRUE
  )
] <- "Control"

pheno$Grupo[
  grepl(
    "^Diabetes",
    pheno$title,
    ignore.case = TRUE
  )
] <- "DN"

if (anyNA(pheno$Grupo)) {
  stop(
    "Pelo menos uma amostra não pôde ser classificada como Control ou DN."
  )
}

# -----------------------------------------------------------------------------
# 9. DEFINIR BLOCO / INDIVÍDUO
# -----------------------------------------------------------------------------

id_local <- sub(
  "^(Control|Diabetes)[ _-]*",
  "",
  pheno$title,
  ignore.case = TRUE
)

id_base <- sub(
  "[ab]$",
  "",
  id_local,
  ignore.case = TRUE
)

pheno$Individuo_Bloco <- paste(
  pheno$Grupo,
  id_base,
  sep = "_"
)

# -----------------------------------------------------------------------------
# 10. SALVAR METADADOS
# -----------------------------------------------------------------------------

write.csv(
  pheno,
  "resultados_GSE1009/metadados_utilizados.csv",
  row.names = TRUE
)

# -----------------------------------------------------------------------------
# 11. LER CEL
# -----------------------------------------------------------------------------

rawData <- read.celfiles(
  filenames = cel_files,
  verbose = TRUE
)

sampleNames(rawData) <- gsm_cel

# -----------------------------------------------------------------------------
# 12. BOXplot BRUTO
# -----------------------------------------------------------------------------

pdf(
  "resultados_GSE1009/figuras/01_boxplot_bruto_log2.pdf",
  width = 10,
  height = 6
)

boxplot(
  log2(exprs(rawData) + 1),
  las = 2,
  main = "GSE1009 - Dados brutos em escala log2",
  ylab = "Intensidade log2",
  outline = FALSE
)

dev.off()

# -----------------------------------------------------------------------------
# 13. RMA
# -----------------------------------------------------------------------------

rmaData <- rma(rawData)

saveRDS(
  rmaData,
  "resultados_GSE1009/GSE1009_RMA.rds"
)

# -----------------------------------------------------------------------------
# 14. BOXPLOT RMA
# -----------------------------------------------------------------------------

pdf(
  "resultados_GSE1009/figuras/02_boxplot_RMA.pdf",
  width = 10,
  height = 6
)

boxplot(
  exprs(rmaData),
  las = 2,
  main = "GSE1009 - Após normalização RMA",
  ylab = "Expressão log2",
  outline = FALSE
)

dev.off()

# -----------------------------------------------------------------------------
# 15. FILTRAGEM
# -----------------------------------------------------------------------------

filtro <- nsFilter(
  rmaData,
  var.func = IQR,
  var.cutoff = 0.5,
  varByQuantile = TRUE,
  feature.exclude = "^AFFX"
)

rma_filtrado <- filtro$eset

saveRDS(
  filtro,
  "resultados_GSE1009/nsFilter_resultado.rds"
)

saveRDS(
  rma_filtrado,
  "resultados_GSE1009/GSE1009_RMA_filtrado.rds"
)

# -----------------------------------------------------------------------------
# 16. MATRIZ
# -----------------------------------------------------------------------------

matriz_expr <- exprs(rma_filtrado)

# -----------------------------------------------------------------------------
# 17. PCA
# -----------------------------------------------------------------------------

pca <- prcomp(
  t(matriz_expr),
  center = TRUE,
  scale. = FALSE
)

percent_PC <- 100 *
  pca$sdev^2 /
  sum(pca$sdev^2)

pca_df <- data.frame(
  Amostra = rownames(pca$x),
  PC1 = pca$x[, 1],
  PC2 = pca$x[, 2]
)

pca_df <- merge(
  pca_df,
  pheno[
    ,
    c(
      "geo_accession",
      "Grupo",
      "Individuo_Bloco"
    )
  ],
  by.x = "Amostra",
  by.y = "geo_accession",
  all.x = TRUE,
  sort = FALSE
)

grafico_pca <- ggplot(
  pca_df,
  aes(
    x = PC1,
    y = PC2,
    label = Amostra
  )
) +
  geom_point(size = 4) +
  geom_text(vjust = -0.8) +
  labs(
    title = "PCA — GSE1009",
    x = paste0(
      "PC1 (",
      round(percent_PC[1], 1),
      "%)"
    ),
    y = paste0(
      "PC2 (",
      round(percent_PC[2], 1),
      "%)"
    )
  ) +
  theme_classic()

ggsave(
  "resultados_GSE1009/figuras/03_PCA_PC1_PC2.pdf",
  plot = grafico_pca,
  width = 8,
  height = 6
)

saveRDS(
  pca,
  "resultados_GSE1009/PCA.rds"
)

# -----------------------------------------------------------------------------
# 18. DESIGN
# -----------------------------------------------------------------------------

grupo <- factor(
  pheno$Grupo,
  levels = c(
    "Control",
    "DN"
  )
)

design <- model.matrix(
  ~ 0 + grupo
)

colnames(design) <- c(
  "Control",
  "DN"
)

# -----------------------------------------------------------------------------
# 19. CONTRASTE
# -----------------------------------------------------------------------------

contraste <- makeContrasts(
  DN - Control,
  levels = design
)

# -----------------------------------------------------------------------------
# 20. CORRELAÇÃO INTRA-BLOCO
# -----------------------------------------------------------------------------

dupcor <- duplicateCorrelation(
  matriz_expr,
  design = design,
  block = pheno$Individuo_Bloco
)

# -----------------------------------------------------------------------------
# 21. MODELO
# -----------------------------------------------------------------------------

fit <- lmFit(
  matriz_expr,
  design = design,
  block = pheno$Individuo_Bloco,
  correlation = dupcor$consensus
)

fit_contraste <- contrasts.fit(
  fit,
  contrasts = contraste
)

fit_contraste <- eBayes(
  fit_contraste
)

# -----------------------------------------------------------------------------
# 22. RESULTADO LIMMA
# -----------------------------------------------------------------------------

resultado_limma <- topTable(
  fit_contraste,
  coef = 1,
  number = Inf,
  adjust.method = "BH",
  sort.by = "P"
)

write.csv(
  resultado_limma,
  "resultados_GSE1009/limma_resultado_completo.csv"
)

saveRDS(
  fit_contraste,
  "resultados_GSE1009/limma_modelo.rds"
)

# -----------------------------------------------------------------------------
# 23. ANOTAÇÃO
# -----------------------------------------------------------------------------

resultado_limma$PROBEID <- rownames(
  resultado_limma
)

probe_ids <- resultado_limma$PROBEID

anotacao <- AnnotationDbi::select(
  hgu95av2.db,
  keys = probe_ids,
  columns = c(
    "SYMBOL",
    "ENTREZID"
  ),
  keytype = "PROBEID"
)

anotacao <- anotacao[
  !duplicated(anotacao$PROBEID),
  ,
  drop = FALSE
]

resultado_anotado <- merge(
  resultado_limma,
  anotacao,
  by = "PROBEID",
  all.x = TRUE,
  sort = FALSE
)

write.csv(
  resultado_anotado,
  "resultados_GSE1009/limma_resultado_anotado_por_sonda.csv",
  row.names = FALSE
)

# -----------------------------------------------------------------------------
# 24. CONSOLIDAÇÃO POR GENE
# -----------------------------------------------------------------------------

resultado_gene <- resultado_anotado[
  !is.na(resultado_anotado$ENTREZID) &
    resultado_anotado$ENTREZID != "",
  ,
  drop = FALSE
]

resultado_gene <- resultado_gene[
  order(
    resultado_gene$ENTREZID,
    resultado_gene$P.Value
  ),
  ,
  drop = FALSE
]

resultado_gene <- resultado_gene[
  !duplicated(resultado_gene$ENTREZID),
  ,
  drop = FALSE
]

write.csv(
  resultado_gene,
  "resultados_GSE1009/limma_resultado_por_gene.csv",
  row.names = FALSE
)

saveRDS(
  resultado_gene,
  "resultados_GSE1009/resultado_gene.rds"
)

# -----------------------------------------------------------------------------
# 25. GENES SIGNIFICATIVOS
# -----------------------------------------------------------------------------

genes_significativos <- resultado_gene[
  resultado_gene$adj.P.Val < 0.05 &
    abs(resultado_gene$logFC) > 1,
  ,
  drop = FALSE
]

write.csv(
  genes_significativos,
  "resultados_GSE1009/genes_significativos.csv",
  row.names = FALSE
)

# -----------------------------------------------------------------------------
# 26. UPREGULATED
# -----------------------------------------------------------------------------

genes_up <- resultado_gene[
  resultado_gene$adj.P.Val < 0.05 &
    resultado_gene$logFC > 1,
  ,
  drop = FALSE
]

write.csv(
  genes_up,
  "resultados_GSE1009/genes_upregulated.csv",
  row.names = FALSE
)

# -----------------------------------------------------------------------------
# 27. IDs PARA GO
# -----------------------------------------------------------------------------

genes_up_entrez <- unique(
  as.character(
    na.omit(
      genes_up$ENTREZID
    )
  )
)

universo_entrez <- unique(
  as.character(
    na.omit(
      resultado_anotado$ENTREZID
    )
  )
)

# -----------------------------------------------------------------------------
# 28. GO-BP
# -----------------------------------------------------------------------------

ego <- enrichGO(
  gene = genes_up_entrez,
  universe = universo_entrez,
  OrgDb = org.Hs.eg.db,
  keyType = "ENTREZID",
  ont = "BP",
  pAdjustMethod = "BH"
)

go_tabela <- as.data.frame(
  ego
)

write.csv(
  go_tabela,
  "resultados_GSE1009/GO_BP_resultados.csv",
  row.names = FALSE
)

saveRDS(
  ego,
  "resultados_GSE1009/GO_BP.rds"
)

# -----------------------------------------------------------------------------
# 29. DOTPLOT
# -----------------------------------------------------------------------------

if (nrow(go_tabela) > 0) {

  p_go <- dotplot(
    ego,
    showCategory = 10
  )

  ggsave(
    "resultados_GSE1009/figuras/04_GO_BP_dotplot.pdf",
    plot = p_go,
    width = 10,
    height = 7
  )
}

# -----------------------------------------------------------------------------
# 30. SESSION INFO
# -----------------------------------------------------------------------------

writeLines(
  capture.output(
    sessionInfo()
  ),
  "resultados_GSE1009/sessionInfo.txt"
)

# -----------------------------------------------------------------------------
# 31. RESUMO
# -----------------------------------------------------------------------------

resumo <- c(
  "RESUMO DA ANALISE GSE1009",
  "",
  paste(
    "Data de execução:",
    Sys.time()
  ),
  paste(
    "Número de arquivos CEL:",
    length(cel_files)
  ),
  paste(
    "Número de amostras:",
    ncol(exprs(rmaData))
  ),
  paste(
    "Probe sets após RMA:",
    nrow(exprs(rmaData))
  ),
  paste(
    "Probe sets após filtro:",
    nrow(exprs(rma_filtrado))
  ),
  paste(
    "Genes significativos:",
    nrow(genes_significativos)
  ),
  paste(
    "Genes upregulated:",
    nrow(genes_up)
  ),
  paste(
    "Genes no universo GO:",
    length(universo_entrez)
  ),
  paste(
    "Genes usados no GO:",
    length(genes_up_entrez)
  ),
  paste(
    "Termos GO-BP:",
    nrow(go_tabela)
  )
)

writeLines(
  resumo,
  "resultados_GSE1009/resumo_analise.txt"
)

# =============================================================================
# FIM DO PIPELINE
# =============================================================================
